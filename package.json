{
  "name": "internshipjunction",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/check-ports.mjs && concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "check:ports": "node scripts/check-ports.mjs",
    "secrets": "node scripts/generate-secrets.mjs",
    "build": "npm run build --workspace=frontend",
    "start": "node index.js",
    "start:backend": "npm run start --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
