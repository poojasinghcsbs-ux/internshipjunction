# ─────────────────────────────────────────────────────────────────────────────
# InternshipJunction - backend environment template
# Copy this file to backend/.env and fill in every required value.
# backend/.env is gitignored: never commit real secrets.
# Generate JWT secrets with: npm run secrets
# ─────────────────────────────────────────────────────────────────────────────

# ── Server (required) ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Optional extra CORS origins, comma-separated (e.g. https://www.example.com)
CORS_ORIGINS=
# Optional: absolute path to frontend/dist if Node.js serves the frontend
STATIC_DIST=

# ── Auth (required) ──────────────────────────────────────────────────────────
# Use long random values from `npm run secrets`, not the examples below.
# Secrets must be at least 32 characters; example values are rejected.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── MySQL (required - this app has no in-memory fallback) ────────────────────
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-your-db-password
DB_NAME=internshipjunction
DB_POOL_SIZE=10
DB_AUTO_CREATE=true
DB_AUTO_MIGRATE=true
# Optional privileged account used only to create the database if it is missing.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# ── Razorpay (optional) ──────────────────────────────────────────────────────
# When false, checkout is simulated end-to-end for testing.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI provider (optional) ───────────────────────────────────────────────────
# When false, deterministic heuristic fallbacks are used.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── File storage (optional) ──────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_BUCKET=internshipjunction-uploads
STORAGE_REGION=ap-south-1
STORAGE_PUBLIC_URL=
