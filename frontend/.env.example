# ─────────────────────────────────────────────────────────────────────────────
# InternshipJunction — Frontend environment variables
# Copy to frontend/.env.local and fill in your values.
# All variables MUST start with VITE_ to be exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL
# Development: leave empty — Vite proxy automatically forwards /api → localhost:5000
# Production:  set to your deployed backend URL e.g. https://api.internshipjunction.com
VITE_API_URL=

# App Info
VITE_APP_NAME=InternshipJunction
VITE_APP_URL=http://localhost:5173
